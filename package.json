{
  "name": "doordash-cli-mcp",
  "version": "0.6.0",
  "private": true,
  "description": "Streamable HTTP MCP wrapper for DoorDash CLI",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "import:sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "install:cli": "node scripts/install-cli.js",
    "test:container": "node scripts/container-smoke.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "pg": "^8.22.0",
    "express": "5.1.0",
    "zod": "4.4.3"
  }
}
